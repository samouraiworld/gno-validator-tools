# {{ ansible_managed }}
# tmkms config for the validator signer — softsign.
# chain_id MUST match the gnoland genesis / config.toml tmkms_listener.chain_id.
{% if tmkms_connection_mode == "tcp" %}
# TCP mode — dedicated signer host, remote from the validator. Paths refer to
# the mounts in compose/tmkms-alone/:
#   ./tmkms.toml -> /tmkms/tmkms.toml
#   ./secrets    -> /tmkms/secrets  (consensus.key copied here out-of-band
#                    from the validator host, see DEPLOYMENT_RUNBOOK.md)
{% else %}
# UDS mode — same host as the validator, Unix socket. Paths refer to the
# mounts in the validator compose:
#   ./tmkms/tmkms.toml -> /tmkms/tmkms.toml
#   ./tmkms/secrets    -> /tmkms/secrets
#   ./tmkms/run        -> /run/gnoland (shared privval socket dir)
{% endif %}

[[chain]]
id = "{{ tmkms_chain_id }}"
key_format = { type = "hex" }
state_file = "/tmkms/secrets/consensus_state.json"

[[providers.softsign]]
chain_ids = ["{{ tmkms_chain_id }}"]
key_type = "consensus"
key_format = "base64"
path = "/tmkms/secrets/consensus.key"

[[validator]]
chain_id = "{{ tmkms_chain_id }}"
{% if tmkms_connection_mode == "tcp" %}
addr = "tcp://{{ tmkms_validator_peer_id }}@{{ tmkms_validator_ip }}:{{ tmkms_validator_port }}"   # peer-id pin is mandatory on TCP
{% else %}
addr = "unix://{{ tmkms_socket_path }}"   # same-host UDS; socket perms = auth
{% endif %}
secret_key = "/tmkms/secrets/kms-identity.key"
protocol_version = "v0.34"
reconnect = true
