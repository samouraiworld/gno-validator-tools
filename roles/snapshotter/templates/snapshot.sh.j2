#!/usr/bin/env bash
# Rendered by roles/snapshotter. Capture ONE chain snapshot from the local
# snapshotter node: stop it (consistent LevelDB copy), tar its gnoland-data/db
# (wal excluded — node-local scratch, rebuilt on start), restart it, rotate.
# A trap guarantees the node is restarted even if the tar fails.
#
# The archive contains ONLY chain data — no secrets. push-to-s3.sh uploads it.
set -euo pipefail

cd "$(dirname "$0")"
export COMPOSE_PROJECT_NAME="gno-snapshotter"

ZSTD_LEVEL=15
ZSTD_THREADS=2
ZSTD_LONG=31
NODE="snapshotter"
DATA_DIR="gnoland-data"
SNAP_DIR="snapshots"
RPC="http://{{ snapshotter_rpc_bind }}"

# Optional overrides from .env (RETENTION_LOCAL, ZSTD_*). .env also holds secrets
# used by push-to-s3.sh; nothing secret is needed here.
[ -f .env ] && set -a && . ./.env && set +a
RETENTION="${RETENTION_LOCAL:-{{ snapshotter_retention_local }}}"

# Compression settings (overridable from .env)
ZSTD_LEVEL="${ZSTD_LEVEL:-15}"
ZSTD_THREADS="${ZSTD_THREADS:-2}"
ZSTD_LONG="${ZSTD_LONG:-31}"

if [ ! -d "$DATA_DIR/db" ]; then
  echo "❌ $DATA_DIR/db not found — is the snapshotter started and synced?" >&2
  exit 1
fi
mkdir -p "$SNAP_DIR"

HEIGHT="$(curl -s --max-time 5 "$RPC/status" \
  | jq -r '.result.sync_info.latest_block_height // "unknown"' 2>/dev/null || echo unknown)"
TS="$(date -u +%Y%m%dT%H%M%SZ)"
OUT="$SNAP_DIR/${HEIGHT}-${TS}.tar.zst"

restart_snapshotter() { docker compose start "$NODE" >/dev/null 2>&1 || true; }
trap restart_snapshotter EXIT

echo "==> Stopping $NODE for a consistent LevelDB copy (height=$HEIGHT)"
docker compose stop "$NODE" >/dev/null

echo "==> Compressing snapshot"
echo "    zstd level   : $ZSTD_LEVEL"
echo "    zstd threads : $ZSTD_THREADS"
echo "    long window  : $ZSTD_LONG"

START=$(date +%s)

tar -C "$DATA_DIR" -cf - db \
  | zstd \
      -"${ZSTD_LEVEL}" \
      --long="${ZSTD_LONG}" \
      -T"${ZSTD_THREADS}" \
      -q \
      -o "$OUT"

END=$(date +%s)

echo "==> Restarting $NODE"
docker compose start "$NODE" >/dev/null
trap - EXIT

# Health check: confirm the snapshotter actually came back up before trusting
# this run (and before push-to-s3.sh ships the archive — see gno-snapshot.service).
HEALTH_TIMEOUT="${HEALTH_CHECK_TIMEOUT:-30}"
echo "==> Health-checking $NODE after restart (timeout ${HEALTH_TIMEOUT}s)"
HEALTHY=0
for ((elapsed=0; elapsed<HEALTH_TIMEOUT; elapsed+=2)); do
  if curl -s --max-time 3 "$RPC/status" \
      | jq -e '.result.sync_info.latest_block_height' >/dev/null 2>&1; then
    HEALTHY=1
    break
  fi
  sleep 2
done

if [ "$HEALTHY" -ne 1 ]; then
  echo "❌ $NODE did not come back healthy after restart (RPC not responding within ${HEALTH_TIMEOUT}s)" >&2
  exit 1
fi
echo "✅ $NODE healthy after restart"

echo "==> Rotating local (keep $RETENTION most recent)"
ls -1t "$SNAP_DIR"/*.tar.zst 2>/dev/null \
  | tail -n +"$((RETENTION + 1))" \
  | xargs -r rm -f

echo
echo "Compression completed in $((END-START)) seconds"
echo "Snapshot size: $(du -h "$OUT" | cut -f1)"
echo "✅ Snapshot written: $OUT"
