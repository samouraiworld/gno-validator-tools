#!/usr/bin/env bash
# Rendered by roles/snapshotter. Push local snapshot archives to Scaleway Object
# Storage with rclone. Runs after snapshot.sh (see gno-snapshot.service).
#
# Secrets: read ONLY from .env (never committed, never in argv). Credentials are
# exported as RCLONE_CONFIG_* env vars so they don't appear in the process list.
# Objects are uploaded in the STANDARD class.
#
# After upload, only the KEEP_LAST snapshots with the highest block height are
# kept in Object Storage.

set -euo pipefail

cd "$(dirname "$0")"

if [ ! -f .env ]; then
  echo "❌ .env missing — copy snapshotter.env.example to .env and fill it in." >&2
  exit 1
fi

set -a
. ./.env
set +a

: "${SCW_ACCESS_KEY:?set SCW_ACCESS_KEY in .env}"
: "${SCW_SECRET_KEY:?set SCW_SECRET_KEY in .env}"
: "${S3_BUCKET:?set S3_BUCKET in .env}"
: "${S3_ENDPOINT:?set S3_ENDPOINT in .env}"
: "${S3_REGION:?set S3_REGION in .env}"

# Optional bucket prefix.
S3_PREFIX="${S3_PREFIX:-}"

# Number of remote snapshots to keep.
KEEP_LAST="${KEEP_LAST:-2}"

# On-the-fly rclone remote "scw".
export RCLONE_CONFIG_SCW_TYPE="s3"
export RCLONE_CONFIG_SCW_PROVIDER="aws"
export RCLONE_CONFIG_SCW_ACCESS_KEY_ID="$SCW_ACCESS_KEY"
export RCLONE_CONFIG_SCW_SECRET_ACCESS_KEY="$SCW_SECRET_KEY"
export RCLONE_CONFIG_SCW_ENDPOINT="$S3_ENDPOINT"
export RCLONE_CONFIG_SCW_REGION="$S3_REGION"
export RCLONE_CONFIG_SCW_STORAGE_CLASS="STANDARD"

DEST="scw:${S3_BUCKET}/${S3_PREFIX}"

echo "==> Uploading snapshots to ${DEST}/"
rclone copy snapshots "$DEST" \
    --include "*.tar.zst" \
    --transfers 2 \
    --s3-chunk-size 64M \
    --stats-one-line

echo "==> Pruning remote snapshots (keeping latest ${KEEP_LAST} by block height)"

mapfile -t FILES < <(
    rclone lsf "$DEST" \
        --files-only \
        --include "*.tar.zst" \
    | sort -t '-' -k1,1n
)

COUNT=${#FILES[@]}

if (( COUNT <= KEEP_LAST )); then
    echo "Nothing to prune (${COUNT} snapshot(s) found)."
    exit 0
fi

TO_DELETE=$((COUNT - KEEP_LAST))

for ((i=0; i<TO_DELETE; i++)); do
    FILE="${FILES[$i]}"
    echo "Deleting ${FILE}"
    rclone deletefile "${DEST}/${FILE}"
done

echo "✅ Push complete."
