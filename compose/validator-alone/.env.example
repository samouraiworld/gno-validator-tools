# validator-alone — copy to .env and fill in, then chmod 600 .env
# .env is never committed (see .gitignore).

IMAGES=
MONIKER=
PERSISTENT_PEERS=

# Optional — remote tmkms signer over TCP (dedicated signer host, see
# compose/tmkms-alone/ and TMKMS.md §4). Leave all three empty to keep
# signing local (default, unchanged behaviour).
# TMKMS_CHAIN_ID=
# TMKMS_LISTEN_ADDR=tcp://0.0.0.0:26659
# TMKMS_ALLOWED_KMS_PUBKEYS=ed25519:<hex — the signer's kms-identity pubkey>
