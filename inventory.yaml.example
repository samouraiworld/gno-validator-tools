---
# =============================================================================
# Ansible inventory — gno-validator-tools
# Copy this file to inventory.yaml and replace all <PLACEHOLDER> values.
#
# Only base_setup.yml (+ the optional setup-private-network.yml,
# install-snapshotter.yml, setup-tmkms.yml, backup-logs.yaml) reads this
# inventory. gnoland itself (docker-compose + config) is deployed manually,
# see DEPLOYMENT_RUNBOOK.md.
# =============================================================================

all:
  vars:
    ansible_user: root
    ansible_python_interpreter: /usr/bin/python3
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no"

  children:

    # --- Validator nodes -------------------------------------------------------
    validators:
      hosts:
        gno-validator:
          ansible_host: <VALIDATOR_PUBLIC_IP>
          public_ip: <VALIDATOR_PUBLIC_IP>
          private_ip: <VALIDATOR_PRIVATE_IP>
          ufw_ports_app: [26656]
          # ufw_ports_moni / ufw_allow_ip: left empty by default (the ufw role
          # treats them as optional). Since the switch to Alloy (push /
          # remote_write), no metrics port needs to be exposed for inbound
          # scraping anymore — node_exporter and otel-collector stay on
          # 127.0.0.1. See NETWORK_AND_REVERSE_PROXY.md.

          # --- Alloy (replaces promtail + node_exporter/otel network exposure) ---
          # Points at the reverse proxy set up by hand in front of the
          # logs/metrics backend — see NETWORK_AND_REVERSE_PROXY.md. "relay"
          # mode carries no bearer token on the validator.
          alloy_logs_enabled: true
          alloy_log_mode: "relay"
          alloy_containers_filter: "<VALIDATOR_MONIKER>"
          alloy_job_name: "<VALIDATOR_MONIKER>"
          alloy_logs_remote_write_url: "<LOGS_PUSH_URL>"
          alloy_remote_write_mode: "relay"
          alloy_remote_write_url: "<METRICS_PUSH_URL>"
          alloy_metrics_targets:
            - { job: "<VALIDATOR_MONIKER>", service: "node_exporter", address: "127.0.0.1:9100" }
            - { job: "<VALIDATOR_MONIKER>", service: "otel", address: "127.0.0.1:9464" }

          # --- tmkms sidecar (optional — see setup-tmkms.yml) -------------------
          # uds mode (default, same host, compose/validator-sentry-tmkms/):
          # tmkms_chain_id: <CHAIN_ID>
          # tmkms_image: "tmkms:local"
          # tmkms_build_image: true

          # tcp mode (dedicated signer host, compose/validator-alone/ +
          # compose/tmkms-alone/ on the signer host — see TMKMS.md §4):
          # open the signer port only to the signer host's IP:
          # ufw_tmkms_port: 26659
          # ufw_tmkms_signer_ip: <SIGNER_HOST_IP>

    # --- Sentry node -----------------------------------------------------------
    sentries:
      hosts:
        gno-sentry:
          ansible_host: <SENTRY_PUBLIC_IP>
          public_ip: <SENTRY_PUBLIC_IP>
          private_ip: <SENTRY_PRIVATE_IP>
          ufw_ports_app: [26656]
          # --- Alloy (direct mode — the sentry pushes its own metrics with its own token) ---
          alloy_remote_write_mode: "direct"
          alloy_remote_write_url: "<METRICS_PUSH_URL>"
          alloy_bearer_token: "<METRICS_BEARER_TOKEN>"
          alloy_metrics_targets:
            - { job: "gno-sentry", service: "node_exporter", address: "127.0.0.1:9100" }

    # --- tmkms signer host (optional, tcp mode only — see TMKMS.md §4) ----------
    # signers:
    #   hosts:
    #     gno-tmkms-signer:
    #       ansible_host: <SIGNER_HOST_IP>
    #       public_ip: <SIGNER_HOST_IP>
    #       private_ip: <SIGNER_HOST_IP>
    #       tmkms_chain_id: <CHAIN_ID>
    #       tmkms_connection_mode: "tcp"
    #       tmkms_validator_peer_id: <VALIDATOR_NODE_ID_HEX>
    #       tmkms_validator_ip: <VALIDATOR_PUBLIC_IP>
    #       tmkms_validator_port: 26659
