---
# =============================================================================
# Ansible inventory — gno-validator-tools
# Copy this file to inventory.yaml and replace all <PLACEHOLDER> values.
#
# Only base_setup.yml (+ the optional setup-private-network.yml,
# install-snapshotter.yml, setup-tmkms.yml, backup-logs.yaml) reads this
# inventory. gnoland itself (docker-compose + config) is deployed manually,
# see DEPLOYMENT_RUNBOOK.md.
# =============================================================================

all:
  vars:
    ansible_user: root
    ansible_python_interpreter: /usr/bin/python3
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no"

  children:

    # --- Validator nodes -------------------------------------------------------
    validators:
      hosts:
        gno-validator:
          ansible_host: <VALIDATOR_PUBLIC_IP>
          public_ip: <VALIDATOR_PUBLIC_IP>
          private_ip: <VALIDATOR_PRIVATE_IP>
          ufw_ports_app: [26656]
          # ufw_ports_moni / ufw_allow_ip: laissés vides par défaut (le rôle ufw
          # les traite comme optionnels). Depuis le passage à Alloy (push /
          # remote_write), plus aucun port de métriques n'a besoin d'être
          # exposé en écoute publique — node_exporter et otel-collector
          # restent en 127.0.0.1. Voir NETWORK_AND_REVERSE_PROXY.md.

          # --- Alloy (remplace promtail + l'exposition réseau de node_exporter/otel) ---
          # Pointe vers le reverse proxy mis en place à la main devant le
          # backend de logs/métriques — voir NETWORK_AND_REVERSE_PROXY.md.
          # Le mode "relay" ne porte aucun bearer token sur le validateur.
          alloy_logs_enabled: true
          alloy_log_mode: "relay"
          alloy_containers_filter: "<VALIDATOR_MONIKER>"
          alloy_job_name: "<VALIDATOR_MONIKER>"
          alloy_logs_remote_write_url: "<LOGS_PUSH_URL>"
          alloy_remote_write_mode: "relay"
          alloy_remote_write_url: "<METRICS_PUSH_URL>"
          alloy_metrics_targets:
            - { job: "<VALIDATOR_MONIKER>", service: "node_exporter", address: "127.0.0.1:9100" }
            - { job: "<VALIDATOR_MONIKER>", service: "otel", address: "127.0.0.1:9464" }

          # --- tmkms sidecar (optionnel — voir setup-tmkms.yml, uniquement ---
          # --- pertinent pour la topologie compose/validator-sentry-tmkms) ---
          # tmkms_chain_id: <CHAIN_ID>
          # tmkms_image: "tmkms:local"
          # tmkms_build_image: true

    # --- Sentry node -----------------------------------------------------------
    sentries:
      hosts:
        gno-sentry:
          ansible_host: <SENTRY_PUBLIC_IP>
          public_ip: <SENTRY_PUBLIC_IP>
          private_ip: <SENTRY_PRIVATE_IP>
          ufw_ports_app: [26656]
          # --- Alloy (mode direct — la sentry pousse ses propres métriques avec son propre token) ---
          alloy_remote_write_mode: "direct"
          alloy_remote_write_url: "<METRICS_PUSH_URL>"
          alloy_bearer_token: "<METRICS_BEARER_TOKEN>"
          alloy_metrics_targets:
            - { job: "gno-sentry", service: "node_exporter", address: "127.0.0.1:9100" }
